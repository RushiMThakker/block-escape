<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for the AdMob banner (ads/AdConfig.kt, ads/BannerAdView.kt) to fetch
         ads over the network. First permissions this app has ever needed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Short vibration feedback on key game moments (move, blocked move, hint, win) -
         see haptics/HapticFeedback.kt. No mute toggle: the Vibrator API already respects
         the system's own vibration settings. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.BlockEscape"
        android:supportsRtl="true">

        <!-- AdMob App ID. Currently Google's public TEST App ID (see admob_app_id in
             strings.xml) — swap that one string resource for the real App ID from the
             AdMob console before release. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- android:theme="Theme.BlockEscape.Starting" here (rather than on
             <application>) follows the documented core-splashscreen pattern of scoping
             the starting theme to the launcher Activity specifically — MainActivity's
             installSplashScreen() call (see MainActivity.kt) reads this theme, shows the
             splash, then switches the window to postSplashScreenTheme
             (Theme.BlockEscape, see values/themes.xml) once the first frame is ready. -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.BlockEscape.Starting"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
