    <path
        android:pathData="M0,98 L108,98 L108,108 L0,108 Z"
        android:fillColor="#3B2A1B"
        android:fillAlpha="0.12" />

    <!-- ===== foreground (ic_launcher_foreground.xml) ===== -->
    <path
