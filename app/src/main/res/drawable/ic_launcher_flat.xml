<?xml version="1.0" encoding="utf-8"?>
<!--
    Non-adaptive fallback launcher icon for API 24-25 (this app's minSdk is 24, but
    <adaptive-icon> only resolves on API 26+). Combines the background and foreground
    adaptive-icon layers (ic_launcher_background.xml / ic_launcher_foreground.xml) into
    a single flat vector at the same 108x108dp canvas, referenced by
    mipmap-anydpi/ic_launcher.xml (note: no "-v26" qualifier, so it resolves on every API
    level, Android 7.0/7.1 included, and AAPT rasterizes this vector into PNG mipmaps at
    build time same as any other launcher icon). Kept in sync by hand with the two layer
    files above since vector drawables can't <include> one another — if you change the
    background/foreground art, mirror the change here too.

    API 24-25 (2016, not security-supported) is a vanishingly small slice of real
    devices at this point, so this fallback intentionally doesn't try to replicate
    adaptive-icon masking/animation — it's just the same board+car art as a flat square,
    which is how most pre-Nougat-MR1 launchers rendered icons anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ===== background (ic_launcher_background.xml) ===== -->
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#8B5A2B" />
    <path
        android:pathData="M0,0h108v32h-108z"
        android:fillColor="#A6714A" />
    <path
        android:pathData="M0,32h108v5h-108z"
        android:fillColor="#3B2A1B"
        android:fillAlpha="0.7" />
    <path
        android:pathData="M0,71h108v5h-108z"
        android:fillColor="#3B2A1B"
        android:fillAlpha="0.7" />
    <path
        android:pathData="M0,76h108v32h-108z"
        android:fillColor="#6B4423" />

    <!-- ===== foreground (ic_launcher_foreground.xml) ===== -->
    <path
        android:pathData="M86,38 L104,38 A16,16 0 0 1 104,70 L86,70 A16,16 0 0 1 86,38 Z"
        android:fillColor="#FFD54F"
        android:fillAlpha="0.35" />
    <path
        android:pathData="M90,44 L104,44 A11,11 0 0 1 104,64 L90,64 A11,11 0 0 1 90,44 Z"
        android:fillColor="#FFD54F"
        android:fillAlpha="0.65" />
    <path
        android:pathData="M33,40 H79 A7,7 0 0 1 86,47 V61 A7,7 0 0 1 79,68 H33
                           A7,7 0 0 1 26,61 V47 A7,7 0 0 1 33,40 Z"
        android:fillColor="#E53935"
        android:strokeColor="#3D0F0C"
        android:strokeWidth="4"
        android:strokeAlpha="1" />
    <path
        android:pathData="M32,47 H80 V61 H32 Z"
        android:fillColor="#6E1512"
        android:fillAlpha="0.32" />
    <path
        android:pathData="M26.5,42 H85.5 A2.5,2.5 0 0 1 88,44.5 A2.5,2.5 0 0 1 85.5,47 H26.5
                           A2.5,2.5 0 0 1 24,44.5 A2.5,2.5 0 0 1 26.5,42 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.4" />
</vector>
