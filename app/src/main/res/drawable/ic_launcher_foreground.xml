<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground layer: the red primary car (Rush Hour's target vehicle),
    plus a soft "exit glow" accent to the right of it, echoing the actual board's
    exit-glow effect (see BoardColors.kt / GameBoardScreen.kt).

    Colors duplicated from BoardColors.kt (Kotlin Color(...) can't be referenced from
    XML) — keep in sync if that palette changes:
      vehiclePrimary = #E53935
      exitGlow       = #FFD54F

    Full 108x108dp adaptive-icon canvas. Only the center ~72x72dp (66%, i.e. the 18..90
    box on both axes) is guaranteed visible once the launcher masks this layer, so the
    car body is kept entirely inside that box (28..86 x / 44..64 y), shifted toward the
    right edge of the safe zone to suggest heading for the exit. The glow accent is
    allowed to bleed past the safe zone toward the edge since it's a non-essential
    accent, not content that needs to survive clipping.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Exit glow: layered soft rounded rects fading out toward the right edge. -->
    <path
        android:pathData="M92,42 L104,42 A10,10 0 0 1 104,66 L92,66 A10,10 0 0 1 92,42 Z"
        android:fillColor="#FFD54F"
        android:fillAlpha="0.16" />
    <path
        android:pathData="M94,46 L104,46 A8,8 0 0 1 104,62 L94,62 A8,8 0 0 1 94,46 Z"
        android:fillColor="#FFD54F"
        android:fillAlpha="0.26" />
    <path
        android:pathData="M96,49 L104,49 A6,6 0 0 1 104,59.5 L96,59.5 A6,6.25 0 0 1 96,49 Z"
        android:fillColor="#FFD54F"
        android:fillAlpha="0.38" />

    <!-- Car body: rounded rect, kept inside the 18..90 safe zone, biased right. -->
    <path
        android:pathData="M34,44 H80 A6,6 0 0 1 86,50 V58 A6,6 0 0 1 80,64 H34
                           A6,6 0 0 1 28,58 V50 A6,6 0 0 1 34,44 Z"
        android:fillColor="#E53935" />

    <!-- Windshield band: subtle darker strip across the middle for definition. -->
    <path
        android:pathData="M37,50 H77 V58 H37 Z"
        android:fillColor="#6E1512"
        android:fillAlpha="0.32" />

    <!-- Glossy top highlight, matching the real board renderer's offset sheen. -->
    <path
        android:pathData="M34.5,46 H79.5 A2.5,2.5 0 0 1 82,48.5 A2.5,2.5 0 0 1 79.5,51 H34.5
                           A2.5,2.5 0 0 1 32,48.5 A2.5,2.5 0 0 1 34.5,46 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.4" />
</vector>
