<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground layer: the red primary car (Rush Hour's target vehicle),
    plus an exit-glow accent to the right of it, echoing the actual board's exit-glow
    effect (see BoardColors.kt / GameBoardScreen.kt).

    Colors duplicated from BoardColors.kt (Kotlin Color(...) can't be referenced from
    XML) — keep in sync if that palette changes:
      vehiclePrimary = #E53935
      exitGlow       = #FFD54F

    v2: real-device screenshots at actual launcher size (~48dp) showed the car reading as
    an ambiguous red bar/pill rather than a vehicle, and the old exit glow (three nested
    arcs topping out at 0.38 alpha) was a barely-visible sliver. Fixes, in order of the
    task's own diagnosis:
      - Car body is bigger (60x28 vs the old 58x20) and now carries a bold dark outline
        stroke, since a flat single-color shape needs a stroke or strong contrast to read
        as "car" at this scale (the in-game vehicles get away without one because they're
        rendered much larger with a glossy gradient for depth - see GameBoardScreen.kt).
      - Exit glow redone as two bolder, higher-alpha layers (0.35/0.65 vs the old
        0.16/0.26/0.38) so it reads as a deliberate glow rather than a sliver.

    Full 108x108dp adaptive-icon canvas. Only the center ~72x72dp (66%, i.e. the 18..90
    box on both axes) is guaranteed visible once the launcher masks this layer, so the car
    body (including its outline stroke) is kept entirely inside that box, shifted toward
    the right edge of the safe zone to suggest heading for the exit. The glow accent is
    allowed to bleed past the safe zone toward the edge since it's a non-essential accent,
    not content that needs to survive clipping.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Exit glow: two layered rounded shapes, bolder and more opaque than v1 so the
         accent is unambiguously visible rather than a sliver. -->
    <path
        android:pathData="M86,38 L104,38 A16,16 0 0 1 104,70 L86,70 A16,16 0 0 1 86,38 Z"
        android:fillColor="#FFD54F"
        android:fillAlpha="0.35" />
    <path
        android:pathData="M90,44 L104,44 A11,11 0 0 1 104,64 L90,64 A11,11 0 0 1 90,44 Z"
        android:fillColor="#FFD54F"
        android:fillAlpha="0.65" />

    <!-- Car body: rounded rect, kept inside the 18..90 safe zone, biased right. Bigger
         than v1 (60x28 vs 58x20) and carries a bold dark outline stroke for contrast
         against the wood background at icon size. -->
    <path
        android:pathData="M33,40 H79 A7,7 0 0 1 86,47 V61 A7,7 0 0 1 79,68 H33
                           A7,7 0 0 1 26,61 V47 A7,7 0 0 1 33,40 Z"
        android:fillColor="#E53935"
        android:strokeColor="#3D0F0C"
        android:strokeWidth="4"
        android:strokeAlpha="1" />

    <!-- Windshield band: subtle darker strip across the middle for definition. -->
    <path
        android:pathData="M32,47 H80 V61 H32 Z"
        android:fillColor="#6E1512"
        android:fillAlpha="0.32" />

    <!-- Glossy top highlight, matching the real board renderer's offset sheen. -->
    <path
        android:pathData="M26.5,42 H85.5 A2.5,2.5 0 0 1 88,44.5 A2.5,2.5 0 0 1 85.5,47 H26.5
                           A2.5,2.5 0 0 1 24,44.5 A2.5,2.5 0 0 1 26.5,42 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.4" />
</vector>
