<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background layer: a bold three-band "wood plank" treatment echoing the
    in-game board (see BoardColors.kt / BoardBackground.kt for the full procedural version
    this is a small static stand-in for). Colors are BoardColors' hex values duplicated
    here because Kotlin Color(...) constants can't be referenced from XML resources — keep
    these in sync with BoardColors.kt if that palette ever changes.

    woodBase  = #8B5A2B
    woodDark  = #6B4423
    woodLight = #A6714A

    v2: replaced the original fine diagonal grain-streak texture (5 thin alpha-blended
    stripes at 0.22-0.38 alpha, plus faint vertical plank-seam hairlines) with three bold,
    fully-opaque horizontal plank bands separated by solid dark seams. The fine grain was
    real-device-verified to be essentially invisible once shrunk to launcher size (~48dp) —
    at that scale, low-alpha 1-2dp-wide streaks just disappear into a flat brown blob. Solid
    high-contrast bands read as "wood" at a glance even at icon size, which was the actual
    design goal (see task notes on real-device launcher legibility).

    Full 108x108dp adaptive-icon canvas. The launcher masks this layer to its own shape
    (circle/squircle/rounded-square/etc); only the center ~72x72dp (66%) is guaranteed
    visible, but background content is allowed to bleed to the edges since it has no
    critical detail that needs to survive clipping.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base plank color fills the whole canvas (also the middle "plank" where the car
         sits, since the top/light and bottom/dark bands below only cover their own
         thirds). -->
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#8B5A2B" />

    <!-- Top plank: lighter tone, full opacity. -->
    <path
        android:pathData="M0,0h108v32h-108z"
        android:fillColor="#A6714A" />

    <!-- Seam between top and middle planks. -->
    <path
        android:pathData="M0,32h108v5h-108z"
        android:fillColor="#3B2A1B"
        android:fillAlpha="0.7" />

    <!-- Seam between middle and bottom planks. -->
    <path
        android:pathData="M0,71h108v5h-108z"
        android:fillColor="#3B2A1B"
        android:fillAlpha="0.7" />

    <!-- Bottom plank: darker tone, full opacity. -->
    <path
        android:pathData="M0,76h108v32h-108z"
        android:fillColor="#6B4423" />
</vector>
