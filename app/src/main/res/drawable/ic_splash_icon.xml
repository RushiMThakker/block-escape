<?xml version="1.0" encoding="utf-8"?>
<!--
    Icon for windowSplashScreenAnimatedIcon (core-splashscreen). Reuses the same
    board-chip + red-car art as the launcher icon (ic_launcher_background.xml /
    ic_launcher_foreground.xml) so the splash-to-app transition reads as "the same
    icon", not a different piece of art.

    windowSplashScreenAnimatedIcon accepts a plain (non-animated) VectorDrawable just
    fine — "Animated" in the attribute name means animation is *supported*, not
    required, per Android's splash-screen docs. No animation is added here since this
    is a vertical slice; the icon is intentionally static.

    Sizing: this environment's docs fetch couldn't confirm Google's exact current
    recommended canvas/safe-zone dp numbers for this drawable (search results returned
    conflicting/unreliable figures), so rather than guess a precise number, this uses a
    deliberately conservative layout: a 240x240dp canvas with the actual artwork
    (background chip + car) confined to the centered 150x150dp region (62.5% of the
    canvas, comfortably inside any commonly documented safe-zone fraction for this slot,
    which universally recommends generous padding so the icon isn't clipped by the
    system's own icon-background circle on API 31+). Verified visually via the cold-start
    screenshot rather than by matching an exact spec number.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">

    <!-- Maps the launcher icon's 108-unit safe-zone content (18..90 square) onto a
         centered 150x150 region of this 240x240 canvas: scale 2.0833x around pivot
         (18,18), then translate by (27,27). See ic_launcher_flat.xml for the same art
         at native scale/coordinates. -->
    <group
        android:translateX="27"
        android:translateY="27">
        <group
            android:pivotX="18"
            android:pivotY="18"
            android:scaleX="2.0833"
            android:scaleY="2.0833">

            <!-- board-chip background -->
            <path
                android:pathData="M0,0h108v108h-108z"
                android:fillColor="#8B5A2B" />
            <path
                android:pathData="M-12,14 L120,4 L120,11 L-12,21 Z"
                android:fillColor="#6B4423"
                android:fillAlpha="0.32" />
            <path
                android:pathData="M-12,33 L120,26 L120,33 L-12,40 Z"
                android:fillColor="#A6714A"
                android:fillAlpha="0.38" />
            <path
                android:pathData="M-12,52 L120,47 L120,54 L-12,59 Z"
                android:fillColor="#6B4423"
                android:fillAlpha="0.28" />
            <path
                android:pathData="M-12,71 L120,67 L120,74 L-12,78 Z"
                android:fillColor="#A6714A"
                android:fillAlpha="0.34" />
            <path
                android:pathData="M-12,90 L120,86 L120,93 L-12,97 Z"
                android:fillColor="#6B4423"
                android:fillAlpha="0.24" />
            <path
                android:pathData="M35,-4 L37.6,-4 L37.6,112 L35,112 Z"
                android:fillColor="#6B4423"
                android:fillAlpha="0.22" />
            <path
                android:pathData="M71,-4 L73.6,-4 L73.6,112 L71,112 Z"
                android:fillColor="#6B4423"
                android:fillAlpha="0.22" />

            <!-- exit glow -->
            <path
                android:pathData="M92,42 L104,42 A10,10 0 0 1 104,66 L92,66 A10,10 0 0 1 92,42 Z"
                android:fillColor="#FFD54F"
                android:fillAlpha="0.16" />
            <path
                android:pathData="M94,46 L104,46 A8,8 0 0 1 104,62 L94,62 A8,8 0 0 1 94,46 Z"
                android:fillColor="#FFD54F"
                android:fillAlpha="0.26" />
            <path
                android:pathData="M96,49 L104,49 A6,6 0 0 1 104,59.5 L96,59.5 A6,6.25 0 0 1 96,49 Z"
                android:fillColor="#FFD54F"
                android:fillAlpha="0.38" />

            <!-- car -->
            <path
                android:pathData="M34,44 H80 A6,6 0 0 1 86,50 V58 A6,6 0 0 1 80,64 H34
                                   A6,6 0 0 1 28,58 V50 A6,6 0 0 1 34,44 Z"
                android:fillColor="#E53935" />
            <path
                android:pathData="M37,50 H77 V58 H37 Z"
                android:fillColor="#6E1512"
                android:fillAlpha="0.32" />
            <path
                android:pathData="M34.5,46 H79.5 A2.5,2.5 0 0 1 82,48.5 A2.5,2.5 0 0 1 79.5,51 H34.5
                                   A2.5,2.5 0 0 1 32,48.5 A2.5,2.5 0 0 1 34.5,46 Z"
                android:fillColor="#FFFFFF"
                android:fillAlpha="0.4" />
        </group>
    </group>
</vector>
